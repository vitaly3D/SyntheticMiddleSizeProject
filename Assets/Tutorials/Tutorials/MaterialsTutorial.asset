--- !u!114 &3476064570558697519
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Let's look at the <b>Lit Shader</b> in more details.\n\n1. Click on a teapot prefab in the tent, and select <b>Teaset_Pot_01_Mesh_LOD0.</b>\n\n2. In the <i>Inspector,</i> expand the <b>Teaset_01_Mat</b> Material. \n\n3. Remove the <b>Metallic Map</b> by clicking on the texture preview and pressing Delete. \n\n4. Experiment with various <b>Metallic</b> and <b>Smoothness</b> values to understand their impact on the rendition of materials.\n\n\nFor more information about the <b>Lit Shader,</b> have a look at the corresponding <a href=\"https://docs.unity3d.com/Packages/com.unity.render-pipelines.universal@latest/index.html?subfolder=/manual/lit-shader.html\">documentation.</a>"
