  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'Take a moment to adjust your Quality Settings for a smooth tutorial experience,  under <b>Edit</b> > <b>Project Settings</b> > <b>Quality.</b>


      To complete all sections of this tutorial, we recommend you use the <b>PC High</b> Quality level. If the framerate in the Scene view is too low, you may switch to <b>Mobile High</b> or lower.'
