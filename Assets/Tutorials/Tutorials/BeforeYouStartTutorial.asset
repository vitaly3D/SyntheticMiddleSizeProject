    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "You can now explore the project on your own and complete the sections of the tutorial in any order you choose. \n\nYou can open each scene individually, in the <i>Project</i> window, under <b>Assets</b> > <b>Scenes.</b>\n\nAt any point, you can consult the URP <a href=\"https://docs.unity3d.com/Packages/com.unity.render-pipelines.universal@latest/index.html\">documentation</a> online, and  provide feedback or ask questions on the <a href=\"https://discussions.unity.com/t/introducing-the-new-urp-3d-sample/929894\">official forum.</a>"
