  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "To enter Play mode in the Editor, press the <b>Play</b> button at the top center of the Editor window. You can navigate the scenes with your mouse and keyboard, or with an attached gamepad. \n\n<b>Mouse and keyboard</b>\nMove the mouse to control the camera orientation, and hold the WASD or arrow keys to move though the scene. Press Shift to move faster.\n\n<b>Gamepad (e.g. Xbox Controller)</b>\nUse the left stick to control the camera orientation, and use the right stick to move through the scene. Press B (or equivalent) to move faster."
